{
    "name": "miem/vk-api-library",
    "description": "Типизированная PHP-библиотека для VK API: сообщения, диалоги и пользователи",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "VkApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VkApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
